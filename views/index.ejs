<!DOCTYPE html>
<html>

    <!-- header -->
    <%- include('./partials/header.ejs') %>

    <body>
    <div class="grid-container">

      <div class="nav">
          <h1>Welcome to Soap Scents</h1>
       </div>

      <div class="header">
        <div>
          <h2>These are the Soap Recipes you have made so far:</h2>
        </div>
        <div>
          <button type="button" name="button" class="button">
            <a href="/soap/new" class="button" style="text-decoration: none">Enter a new soap</a>
          </button>
        </div>
      </div>

      <div class="side-bar">
        <h2>About</h2>
        <img src="https://i.imgur.com/dqrbSs6.jpg" class="headShot" alt="Headshot">
        <p>In a my dream world, I would be able to make amazing soaps and sell them on this website!</p>
        <p>Unfortunately, I am currently furloughed and we have 4 wonderful kids whom's college loan we are helping pay off.</p>
        <p>And, with 3 bootcamps in my pocket, it is impossible to get an entry level website developer gig!</p>
      </div>

      <div class="soap-list">
        <ul>
          <% for (let i = 0; i < soap.length; i++) { %>
          <li>
            <form action="/soap/<%= soap[i].id %>?_method=DELETE" method="POST">
                
              <div class="soap-card-container">
                  
                <a class="soap-name text-decoration: none;"><%= soap[i].name %></a>
                
                <div class="flex-row">
                  <a href="/soap/<%= soap[i].id %>"" class="button"  style="text-decoration: none;">View</a>
                  <a href="/soap/<%= soap[i].id %>/edit" class="button"  style="text-decoration: none;">Edit</a>
                  <input type="submit" value="Delete" class="button" />
                </div>
                <img src="<%= soap[i].image %>.jpg" alt="Soap Image">
              </div>
                
              </form>
            </li>
          <% } %>           
        </ul>
      </div>

      <!-- footer -->
      <%- include('./partials/footer.ejs') %>

    </div>
  </body>
</html>
