<!DOCTYPE html>
<html>

    <!-- header -->
    <%- include('./partials/header.ejs') %>

    <body>
    <div class="grid-container">

      <div class="nav">
          <h1>Welcome to Soap Scents</h1>
          <h2>5/28/2026 - This website is currently being redesigned from boot camp to have better asthetics</h2>
      </div>

      <div class="header">
        <div>
          <h2>These are the Soap Recipes you have made so far:</h2>
        </div>
        <div>
          <button type="button" name="button" class="button">
            <a href="/soap/new" class="button" style="text-decoration: none">Enter a new soap</a>

          </button>
        </div>
      </div>

      <div class="side-bar">
        <h2>About</h2>
        <p>Add my Dumb Portfolio Photo</p>
        <p>In a perfect world, I would be able to make amazing soaps and sell them on this website!</p>
        <p>Unfortunately, I am currently furloughed and we have 4 wonderful kids whom's college loan we are helping pay off.</p>
        <p>And, with 3 bootcamps in my pocket, it is impossible to get an entry level website developer gig!</p>
        <div class="icons">
          <a href="https://www.facebook.com/carole.brnotierney/" style="left: 1120px; top: 1000%"><i class="fab fa-facebook-square fa-2x fa-fw"></i></a>

          <a href="mailto:caroleatierney@gmail.com" target="_top" style="left: 1140px; top: 1000%"><i class="fas fa-envelope fa-2x fa-fw" target="_blank"></i></a>

          <a href="https://www.instagram.com/caroleatierney" style="left: 1160px; top: 1000%" target="_blank"><i class="fab fa-instagram-square fa-2x fa-fw"></i></a>

          <a href="www.linkedin.com/in/caroleatierney" style="left: 1160px; top: 1000%" target="_blank"><i class="fab fa-linkedin fa-2x fa-fw"></i> </a>
        </div>
        <div>
          <div class="contact">
            <h2><b>Dream Studio Location</b></h2>
            Careswell Street<br/>
            Green Harbor, MA  02050<br/>
    </div>
            <a href="tel:6177750725" style="color: blue">(617) 775-0725</a><br/>

            <a href='https://goo.gl/maps/Z2ADBDxKiemAEBfY9' title='Directions' style="color: blue"> Directions</a><br/>
        </div>
      </div>

      <div class="soap-list">
        <ul>
          <% for (let i = 0; i < soap.length; i++) { %>
          <li>
            <form action="/soap/<%= soap[i].id %>?_method=DELETE" method="POST">
                
              <div class="soap-card-container">
                  
                <a class="style="text-decoration: none;"><%= soap[i].name %></a>
                
                <div class="flex-row">
                  <a href="/soap/<%= soap[i].id %>/view" class="button"  style="text-decoration: none;">View</a>
                  <a href="/soap/<%= soap[i].id %>/edit" class="button"  style="text-decoration: none;">Edit</a>
                  <input type="submit" value="Delete" class="button" />
                </div>
                <img src="<%= soap[i].image %>.jpg" alt="Soap Image">
                  
              </div>
                
              </form>
            </li>
          <% } %>           
        </ul>
</div>

        <!-- footer -->
        <%- include('./partials/footer.ejs') %>

      </div>
    </body>
</html>
