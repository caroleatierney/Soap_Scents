<!DOCTYPE html>
<html lang="en" dir="ltr">

  <!-- header -->
  <%- include('./partials/header.ejs') %>

  <body>

    <div class="nav">
      <button type="button" name="button" class="button"><a href="/soap" style="text-decoration: none">Back to Soap Index</a></button>
    </div>

    <div>
      <h1>Soap Scents</h1>
      <h2>Enter a New Soap</h2>
    </div>

    <div>

        <form action="/soap" class="form" method="POST">

        <div class="new-soap-div">
          <div class="new-soap-ingredients">
            <label for="name">Soap Name:</label>
            <input class ="inputLg" type="text" name="name" placeholder="Soap Name" /><br>

            <label for="image">Soap Image:</label>
            <input class ="inputLg" type="url" name="image" required placeholder="Soap Image url"/><br>

              <table id="Ingredients">
                  <tr>
                    <th>Ingredient</th>
                    <th> Amount in ounces</th>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="ingredient1" required /></td>
                    <td><input class ="inputSm" type="number" step="0.01" name="amount1" required /></td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="ingredient2" /></td>
                    <td><input class ="inputSm" type="number" name="amount2"/></td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="ingredient3" /></td>
                    <td><input class ="inputSm" type="number" step="0.01" name="amount3"/></td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="ingredient4" /></td>
                    <td><input class ="inputSm" type="number" step="0.01" name="amount4"/></td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="ingredient5" /></td>
                    <td><input class ="inputSm" type="number" step="0.01" name="amount5"/></td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="ingredient6" /></td>
                    <td><input class ="inputSm" type="number" step="0.01" name="amount6"/></td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="ingredient7" /></td>
                    <td><input class ="inputSm" type="number" step="0.01"name="amount7"/></td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="ingredient8" /></td>
                    <td><input class ="inputSm" type="number" step="0.01" name="amount8"/></td>
                  </tr>

              </table>

            </div>

            <div class="new-soap-cost">

                <table id="Ingredients">
                  <tr>
                    <th>Purchase Information</th>
                    <th> Cost</th>
                  </tr>
                  <tr>
                    <td><label for "costPerBar">Cost Per Bar</label></td>
                    <td><input class ="inputSm" type="number" step="0.01" name="costPerBar" required /></td>
                  </tr>
                  <tr>
                    <td><label for "costPerPound">Cost Per Pound</label></td>
                    <td><input class ="inputSm" type="number" step="0.01" name="costPerPound" required /></td>
                  </tr>
                  <tr>
                    <td><label for "addCostToGiftWrapBar">Cost to Gift Wrap Per Bar</label></td>
                    <td><input class ="inputSm" type="number" step="0.01" name="addCostToGiftWrapPerBar" required /></td>
                  </tr>
                  <tr>
                    <td><label for "totalBarsAvailable">Bars Available</label></td>
                    <td><input class ="inputSm" type="number" name="totalBarsAvail" required /></td>
                  </tr>
              </table>

              <table id="Ingredients">
                  <tr>
                    <th>Additional Information</th>
                    <th> </th>
                  </tr>
                  <tr>
                    <td><label for "percentSuperFat">Percent Superfat</label></td>
                    <td><input 
                      class ="inputSm"
                      type="number"
                      min="0"
                      max="100"
                      step="any"
                      inputmode="decimal"
                      name="percentSuperFat"
                      placeholder="%"
                      required />
                    </td>
                  </tr>
                  <tr>
                    <td><label for "exfoliating">Exfoliating?</label></td>
                    <td><input class ="check" type="checkbox" name="exfoliating" /></td>
                  </tr>
              </table>
              <div class="notes"> 
                <label for="notes">Notes</label>
                <textarea
                  class ="inputNotes"
                  id="soapNotes" name="notes"
                  rows="1" 
                  placeholder="Enter recipe notes here..."
                  ></textarea>
                <br>
              </div>
            </div>

            <div class="new-soap-lye-weight">            
              <table id="Ingredients">
                  <tr>
                    <th>Weights</th>
                    <th> Amount</th>
                  </tr>
                  <tr>
                    <td><label for "totalOilsWeight">Total Oils Weight</label></td>
                    <td><input class ="inputSm" type="number" name="totalOilsWeight" required /></td>
                  </tr>
                  <tr>
                    <td><label for"totalRecipeWeight">Total Recipe Weight<label/></td>
                    <td><input class ="inputSm" type="number" name="totalRecipeWeight" required /></td>
                  </tr>
            </table>
             <table id="Ingredients">
              <tr>
                <th>Lye Calculation</th>
                <th> Amount</th>
              </tr>
              <tr>
                <td><label for "minimumWaterNeeded">Minimum Water Needed<label/></td>
                 <td><input class ="inputSm" type="number" name="minimumWaterNeeded" required /></td>
              </tr>
              <tr>
                <td><label for "sodiumHydroxide"></label>Sodium Hydroxide<label/></td>
                <td><input class ="inputSm" type="number" name="sodiumHydroxide" required /></td>
                </tr>
              </table>

              <input class="button" type="submit" value="Submit New Soap"/><br>
            </div>
          </div>
        </div>
      </form>

    </div>

<script>
  // 1. Define the scaling logic safely
  function autoExpand(textarea) {
    textarea.style.height = 'auto';
    textarea.style.height = textarea.scrollHeight + 'px';
  }

  // 2. Find the element after the page elements exist
  const notesArea = document.getElementById('soapNotes');
  
  // 3. Listen for typing events completely within JavaScript
  if (notesArea) {
    notesArea.addEventListener('input', function() {
      autoExpand(this);
    });
  }
</script>

    <!-- footer -->
    <%- include('./partials/footer.ejs') %>

    </div>
  </body>
</html>
