<!DOCTYPE html>
<html lang="en" dir="ltr">

  <!-- header -->
  <%- include('./partials/header.ejs') %>

  <body>

    <div class="nav">
      <button type="button" name="button" class="button"><a href="/soap" style="text-decoration: none">Back to Soap Index</a></button>
    </div>

    <div>
      <h1>Soap Scents</h1>
      <h2>Enter a New Soap</h2>
    </div>

    <div>

        <form action="/soap/" class="form" method="POST">

        <div class="new-soap-div">
          <div class="new-soap-ingredients">
            <label for="name">Soap Name:</label>
              <input class ="inputLg" type="text" name="name" placeholder="Soap Name" /><br>

              <label for="image">Soap Image:</label>
              <input class ="inputLg" type="url" name="image" required placeholder="Soap Image url"/><br>

              <table id="Ingredients">
                  <tr>
                    <th>Ingredient</th>
                    <th> Amount in ounces</th>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="ingredient1" required /></td>
                    <td><input class ="inputSm" type="number" step="0.01" name="amount1" required /></td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="ingredient2" required /></td>
                    <td><input class ="inputSm" type="number" name="amount2" required /></td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="ingredient3" required /></td>
                    <td><input class ="inputSm" type="number" step="0.01" name="amount3" required /></td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="ingredient4" required /></td>
                    <td><input class ="inputSm" type="number" step="0.01" name="amount4" required /></td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="ingredient5" required /></td>
                    <td><input class ="inputSm" type="number" step="0.01" name="amount5" required /></td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="ingredient6" required /></td>
                    <td><input class ="inputSm" type="number" step="0.01" name="amount6" required /></td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="ingredient7" required /></td>
                    <td><input class ="inputSm" type="number" step="0.01"name="amount7" required /></td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="ingredient8" required /></td>
                    <td><input class ="inputSm" type="number" step="0.01" name="amount8" required /></td>
                  </tr>

              </table>

            </div>

            <div class="new-soap-cost">

                <table id="Ingredients">
                  <tr>
                    <th>Purchase Information</th>
                    <th> Cost</th>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="Cost Per Bar" placeholder="Cost Per Bar" required/></td>
                    <td><input class ="inputSm" type="number" step="0.01" name="costPerBar" required /></td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="Cost Per Pound" placeholder="Cost Per Pound" required /></td>
                    <td><input class ="inputSm" type="number" step="0.01" name="costPerPound" required /></td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="Cost to Gift Wrap Per Bar" placeholder="Cost to Gift Wrap Per Bar" required /></td>
                    <td><input class ="inputSm" type="number" step="0.01" name="addCostToGiftWrapPerBar" required /></td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="Bars Available" placeholder="Bars Available" required/></td>
                    <td><input class ="inputSm" type="number" name="totalBarsAvail" required /></td>
                  </tr>
              </table>

              <table id="Ingredients">
                  <tr>
                    <th>Additional Information</th>
                    <th> Cost</th>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="Percent Super Fat" placeholder="Percent Superfat" required /></td>
                    <td><input 
                      class ="inputSm"
                      type="number"
                      min="0"
                      max="100"
                      step="any"
                      inputmode="decimal"
                      name="percentSuperFat"
                      placeholder="%"
                      required />
                    </td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="Exfoliating?" placeholder="Exfoliating?" required /></td>
                    <td><input class ="inputSm" type="number" name="exfoliating" required /></td>
                  </tr>
              </table>

              <label for="notes">Notes</label>
              <textarea
                class ="inputNotes"
                name="notes"
                rows="1" 
                placeholder="Enter recipe notes here..."
                oninput="autoExpand(this)"
                ></textarea>
              <br>
            </div>
            <div class="new-soap-lye-weight"> 
              <table id="Ingredients">
                  <tr>
                    <th>Lye Calculation</th>
                    <th> Amount</th>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="Minimum Water Needed" placeholder="Minimum Water Needed" required /></td>
                    <td><input class ="inputSm" type="number" name="minimumWaterNeeded" required /></td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="Sodium Hydroxide" placeholder="Sodium Hydroxide" required /></td>
                    <td><input class ="inputSm" type="number" name="sodiumHydroxide" required /></td>
                  </tr>
              </table>
            
              <table id="Ingredients">
                  <tr>
                    <th>Weights</th>
                    <th> Amount</th>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="Total Oils Weight" placeholder="Total Oils Weight" required/></td>
                    <td><input class ="inputSm" type="number" name="totalOilsWeight" required /></td>
                  </tr>
                  <tr>
                    <td><input class ="inputMed" type="text" name="Total Recipe Weight" placeholder="Total Recipe Weight" required /></td>
                    <td><input class ="inputSm" type="number" name="totalRecipeWeight" required /></td>
                  </tr>
              </table>

              <input class="button" type="submit" value="Submit New Soap"/><br>
            </div>
          </div>
        </div>
      </form>

    </div>

    <!-- footer -->
    <%- include('./partials/footer.ejs') %>

    </div>
  </body>
</html>
