<!DOCTYPE html>
<html lang="en" dir="ltr">

  <!-- header -->
  <%- include('./partials/header.ejs') %>

  <body>

    <div class="soap-container">

      <div>
        <button type="button" name="button" class="button">
          <a href="/soap" class="button" style="text-decoration: none">Back to Soap Index</a>
        </button>
      </div>

      <div class="header">
        <% if (soap.name) { %>
          <h1 class="soap-name"><%= soap.name %></h1>
        <% } %>
      </div>

      <div class="side-bar">
        <img src="<%= soap.image %>.jpg" alt="Soap Image" width="100%" height="100%">
      </div>
      
      <div class="soap-ingredients">
      <table id="Ingredients">
        <tr>
          <th>Ingredient</th>
          <th> Amount in ounces</th>
        </tr>
        <tr>
          <%if (soap.ingredients.amount1 > 0) { %>
              <td><%=soap.ingredients.ingredient1%></td>
              <td><%=soap.ingredients.amount1%></td>
          <%}%>
        </tr>
        <tr>
          <%if (soap.ingredients.amount2 > 0) { %>
            <td><%=soap.ingredients.ingredient2%></td>
            <td><%=soap.ingredients.amount2%></td>
          <%}%>
        </tr>
        <tr>
          <%if (soap.ingredients.amount3 > 0) { %>
            <td><%=soap.ingredients.ingredient3%></td>
            <td><%=soap.ingredients.amount3%></td>
          <%}%>
        </tr>
        <tr>
          <%if (soap.ingredients.amount4 > 0) { %>
            <td><%=soap.ingredients.ingredient4%></td>
            <td><%=soap.ingredients.amount4%></td>
          <%}%>
        </tr>
        <tr>
          <%if (soap.ingredients.amount5 > 0) { %>
            <td><%=soap.ingredients.ingredient5%></td>
            <td><%=soap.ingredients.amount5%></td>
          <%}%>
        </tr>
        <tr>
          <%if (soap.ingredients.amount6 > 0) { %>
            <td><%=soap.ingredients.ingredient6%></td>
            <td><%=soap.ingredients.amount6%></td>
          <%}%>
        </tr>
        <tr>
          <%if (soap.ingredients.amount7 > 0) { %>
            <td><%=soap.ingredients.ingredient7%></td>
            <td><%=soap.ingredients.amount7%></td>
          <%}%>
        </tr>
        <tr>
          <%if (soap.ingredients.amount8 > 0) { %>
            <td><%=soap.ingredients.ingredient8%></td>
            <td><%=soap.ingredients.amount8%></td>
          <%}%>
        </tr> 
    </table>

        </div>

        <div class="soap-cost">
            <h3>Purchase Information</h3>
            Cost Per Bar: <%=soap.costPerBar%> <br>
            Cost Per Pound: <%=soap.costPerPound%> <br>
            Cost per Bar to gift wrap:  <%=soap.addCostToGiftWrapPerBar%> <br>
            Bars Available for Purchase:  <%=soap.totalBarsAvail%> <br>

            <h3>Additional Information</h3>
            % Super Fat:  <%=soap.percentSuperFat%> <br>
            Exfoliating? <%=soap.exfoliating%> <br>
            Notes: <%=soap.notes%> <br>
        </div>

        <div class="soap-lye-weight">
          <h3> Lye Calculation </h3>
            <% if (soap.lyeCalculation && soap.lyeCalculation.minimumWaterNeeded > 0) { %>
              Minimum Water Needed: <%= soap.lyeCalculation.minimumWaterNeeded %><br>
            <% } %>

            <% if (soap.lyeCalculation && soap.lyeCalculation.sodiumHydroxide > 0) { %>
              Sodium Hydroxide: <%= soap.lyeCalculation.sodiumHydroxide %><br>
            <% } %>

          <h3> Weights </h3>
          Total Oils Weight: <%=soap.totalOilsWeight%><br>
          Total Recipe Weight: <%=soap.totalRecipeWeight%><br>
        </div>
       </div>
       <!-- footer -->
       <%- include('./partials/footer.ejs') %>

    </div>
  </body>
</html>
