<!DOCTYPE html>
<html lang="en" dir="ltr">

  <!-- header -->
  <%- include('./partials/header.ejs') %>

  <body>

    <div class="soap-container">

      <div class="nav">
        <button type="button" name="button" class="button"><a href="/soap" style="text-decoration: none">Back to Soap Index</a></button>
        <h1>Soap Scents</h1>
      </div>

      <div class="header">
        <% if (soap.name) { %>
          <h2>View <%= soap.name %></h2>
        <% } %>
      </div>

      <div class="side-bar">
        <img src="<%= soap.image %>.jpg" alt="Soap Image" width="100%" height="100%">
      </div>
      
      <div class="soap-ingredients">
      <table id="Ingredients">
        <tr>
          <th>Ingredient</th>
          <th> Amount in ounces</th>
        </tr>
        <tr>
          <%if (soap.ingredients.amount1 > 0) { %>
              <td><%=soap.ingredients.ingredient1%></td>
              <td><%=soap.ingredients.amount1%></td>
          <%}%>
        </tr>
        <tr>
          <%if (soap.ingredients.amount2 > 0) { %>
            <td><%=soap.ingredients.ingredient2%></td>
            <td><%=soap.ingredients.amount2%></td>
          <%}%>
        </tr>
        <tr>
          <%if (soap.ingredients.amount3 > 0) { %>
            <td><%=soap.ingredients.ingredient3%></td>
            <td><%=soap.ingredients.amount3%></td>
          <%}%>
        </tr>
        <tr>
          <%if (soap.ingredients.amount4 > 0) { %>
            <td><%=soap.ingredients.ingredient4%></td>
            <td><%=soap.ingredients.amount4%></td>
          <%}%>
        </tr>
        <tr>
          <%if (soap.ingredients.amount5 > 0) { %>
            <td><%=soap.ingredients.ingredient5%></td>
            <td><%=soap.ingredients.amount5%></td>
          <%}%>
        </tr>
        <tr>
          <%if (soap.ingredients.amount6 > 0) { %>
            <td><%=soap.ingredients.ingredient6%></td>
            <td><%=soap.ingredients.amount6%></td>
          <%}%>
        </tr>
        <tr>
          <%if (soap.ingredients.amount7 > 0) { %>
            <td><%=soap.ingredients.ingredient7%></td>
            <td><%=soap.ingredients.amount7%></td>
          <%}%>
        </tr>
        <tr>
          <%if (soap.ingredients.amount8 > 0) { %>
            <td><%=soap.ingredients.ingredient8%></td>
            <td><%=soap.ingredients.amount8%></td>
          <%}%>
        </tr> 
    </table>

    </div>

    <div class="soap-cost">
      <table id="Ingredients">
        <tr>
          <th>Purchase Information</th>
          <th>Cost</th>
        </tr>
        <tr>
          <td><label for="costPerBar">Cost Per Bar</label></td>
          <td><%=soap.costPerBar%></td>
        </tr>
        <tr>
          <td><label for="costPerPound">Cost Per Pound</label></td>
          <td><%=soap.costPerPound%></td>
        </tr>
        <tr>
          <td><label for="addCostToGiftWrapPerBar">Cost to Gift Wrap Per Bar</label></td>
          <td><%=soap.addCostToGiftWrapPerBar%></td>
        </tr>
        <tr>
          <td><label for="totalBarsAvailable">Bars Available</label></td>
          <td><%=soap.totalBarsAvail%></td>
        </tr>
      </table>

      <table id="Ingredients">
        <tr>
          <th>Additional Information</th>
          <th> </th>
        </tr>
        <tr>
          <td><label for="percentSuperFat">Percent Superfat</label></td>
          <td><%=soap.percentSuperFat%></td>
        </tr>
        <tr>
          <td><label for="exfoliating">Exfoliating?</label></td>
          <td><%=soap.exfoliating%></td>
        </tr>
      </table>
        
      <div class="notes">
        <label for="notes">Notes</label>
          <textarea readonly><%=soap.notes%></textarea>
        <br>
      </div>
    </div>

        <div class="soap-lye-weight">
      <table id="Ingredients">
          <tr>
              <th>Weights</th>
              <th>Amount</th>
          </tr>
          <tr>
              <td><label for="totalOilsWeight">Total Oils Weight</label></td>
              <td><%=soap.totalOilsWeight%></td>
          </tr>
          <tr>
             <td><label for="totalRecipeWeight">Total Recipe Weight</label></td>
             <td><%=soap.totalRecipeWeight%></td>
          </tr>
      </table>
      <br>

      <table id="Ingredients">
        <tr>
            <th>Lye Calculation</th>
            <th> </th>
        </tr>
        <tr>
          <td><label for="minimumWaterNeeded">Minimum Water Needed</label></td>
          <td><%=soap.lyeCalculation.minimumWaterNeeded%></td>
        </tr>
        <tr>
          <td><label for="sodiumHydroxide">Sodium Hydroxide</label></td>
          <td><%=soap.lyeCalculation.sodiumHydroxide%></td>
        </tr>
      </table>
      <br>

      <input class="button" type="submit" value="Submit Changes"/><br>
      </div>
    </div>

       <!-- footer -->
       <%- include('./partials/footer.ejs') %>

    </div>
  </body>
</html>
